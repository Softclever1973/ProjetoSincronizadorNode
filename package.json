{
  "name": "projeto-sincronizador-node",
  "version": "6.0.3",
  "description": "Servidor de sincronização Firebird matriz/filiais",
  "type": "commonjs",
  "main": "src/server.js",
  "imports": {
    "#server/*": "./src/server/*",
    "#client/*": "./src/client/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "client": "node src/client/index.js",
    "client:dev": "nodemon src/client/index.js",
    "generate-secret": "node -e \"process.stdout.write(require('crypto').randomBytes(64).toString('hex') + '\\n')\"",
    "build:server": "node scripts/prepare-pkg-build.js && pkg --config .pkg-build/package.json .pkg-build/src/server.js --target node22-win-x64 --output dist/server.exe",
    "build:client": "node scripts/prepare-pkg-build.js && pkg --config .pkg-build/package.json .pkg-build/src/client/index.js --target node22-win-x64 --output dist/client.exe",
    "test": "jest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.1",
    "ejs": "^5.0.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "node-firebird": "^1.1.5",
    "pg": "^8.20.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.20.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "package.json",
      "src/client/views/**/*",
      "src/client/public/**/*",
      "src/client/assets/**/*",
      "node_modules/systray2/traybin/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "*.ini",
      "conflitos.json",
      "tabelas-config.json",
      "parametros-sync.json",
      ".update-pending.json"
    ]
  }
}
