<script>
  /**
   * _notificarErro — substitui alert() nativo por feedback inline acessível.
   * Insere role="alert" após o botão de origem e remove automaticamente.
   */
  function _notificarErro(btn, mensagem) {
    var id = '_err_' + Math.random().toString(36).slice(2);
    var el = document.createElement('span');
    el.id = id;
    el.setAttribute('role', 'alert');
    el.style.cssText = 'color:var(--color-danger,#b91c1c);font-size:12px;margin-left:8px;font-weight:600;display:inline-block;margin-top:4px';
    el.textContent = mensagem;
    if (btn && btn.parentNode) btn.parentNode.insertBefore(el, btn.nextSibling);
    else document.body.appendChild(el);
    setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 6000);
  }

  async function corrigir(tabela, offset, escolha) {
    escolha = escolha || 'matriz';
    var btn = event.target;
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.classList.add('btn-loading');
    btn.setAttribute('aria-label', 'Processando correção...');
    try {
      var r = await fetch('/auditoria/corrigir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tabela: tabela, offset: offset, escolha: escolha })
      });
      var data = await r.json();
      if (data.ok) {
        if (escolha === 'manual') {
          window.location.href = '/';
        } else {
          btn.classList.remove('btn-loading');
          btn.textContent = 'Concluído: ' + data.processados + ' registro(s)';
          btn.setAttribute('aria-label', originalText);
          setTimeout(function() { location.reload(); }, 1500);
        }
      } else {
        _notificarErro(btn, 'Erro: ' + (data.message || 'desconhecido'));
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        btn.textContent = originalText;
        btn.setAttribute('aria-label', originalText);
      }
    } catch(e) {
      _notificarErro(btn, 'Erro de rede: ' + e.message);
      btn.disabled = false;
      btn.classList.remove('btn-loading');
      btn.textContent = originalText;
      btn.setAttribute('aria-label', originalText);
    }
  }

  async function resolver(id, escolha) {
    var btn = event.target;
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.classList.add('btn-loading');
    btn.setAttribute('aria-label', 'Processando resolução do conflito...');
    try {
      var r = await fetch('/conflitos/' + id + '/resolver', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ escolha: escolha })
      });
      var data = await r.json();
      if (data.ok) {
        location.reload();
      } else {
        _notificarErro(btn, 'Erro: ' + (data.message || 'desconhecido'));
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        btn.textContent = originalText;
        btn.setAttribute('aria-label', originalText);
      }
    } catch(e) {
      _notificarErro(btn, 'Erro de rede: ' + e.message);
      btn.disabled = false;
      btn.classList.remove('btn-loading');
      btn.textContent = originalText;
      btn.setAttribute('aria-label', originalText);
    }
  }

  async function resolverMesclado(conflitoid) {
    var campos = {};
    document.querySelectorAll('[name^="campo-' + conflitoid + '-"]').forEach(function(r) {
      if (r.checked) {
        var col = r.name.replace('campo-' + conflitoid + '-', '');
        campos[col] = r.value;
      }
    });
    var btn = event.target;
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.classList.add('btn-loading');
    btn.setAttribute('aria-label', 'Aplicando mesclagem...');
    try {
      var r = await fetch('/conflitos/' + conflitoid + '/resolver', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ escolha: 'mesclar', campos: campos })
      });
      var data = await r.json();
      if (data.ok) {
        location.reload();
      } else {
        _notificarErro(btn, 'Erro: ' + (data.message || 'desconhecido'));
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        btn.textContent = originalText;
        btn.setAttribute('aria-label', originalText);
      }
    } catch(e) {
      _notificarErro(btn, 'Erro de rede: ' + e.message);
      btn.disabled = false;
      btn.classList.remove('btn-loading');
      btn.textContent = originalText;
      btn.setAttribute('aria-label', originalText);
    }
  }

  // ── Banner de atualização automática (renderizado no load e ao vivo via SSE) ─────
  var ESTADOS_TRANSITORIOS_ATUALIZACAO = ['aplicando', 'respawned', 'sucesso', 'revertida'];
  var CORES_STATUS_ATUALIZACAO = {
    aplicando: { bg: '#dbeafe', border: '#93c5fd', text: '#1e40af', icone: '⏳' },
    respawned: { bg: '#dbeafe', border: '#93c5fd', text: '#1e40af', icone: '⏳' },
    sucesso:   { bg: '#dcfce7', border: '#86efac', text: '#166534', icone: '✅' },
    revertida: { bg: '#fee2e2', border: '#fca5a5', text: '#991b1b', icone: '⚠️' },
  };
  var TEXTOS_STATUS_ATUALIZACAO = {
    aplicando: function(v) { return 'Atualizando para v' + v + '…'; },
    respawned: function(v) { return 'Atualizando para v' + v + '…'; },
    sucesso:   function(v) { return 'Atualizado com sucesso para v' + v + '.'; },
    revertida: function(v) { return 'Falha ao atualizar para v' + v + ' — revertido automaticamente para a versão anterior.'; },
  };

  function renderBannerAtualizacao(disponivel, status) {
    var wrap = document.getElementById('banner-atualizacao-wrap');
    if (!wrap) return;

    if (status && ESTADOS_TRANSITORIOS_ATUALIZACAO.indexOf(status.status) !== -1) {
      var cor = CORES_STATUS_ATUALIZACAO[status.status];
      var texto = TEXTOS_STATUS_ATUALIZACAO[status.status](status.versao);
      wrap.innerHTML =
        '<div id="banner-atualizacao" style="background:' + cor.bg + ';border-bottom:1px solid ' + cor.border +
        ';color:' + cor.text + ';padding:8px 16px;font-size:13px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">' +
        '<span>' + cor.icone + ' ' + texto + '</span></div>';
      return;
    }

    if (disponivel) {
      wrap.innerHTML =
        '<div id="banner-atualizacao" style="background:#fef3c7;border-bottom:1px solid #fcd34d;color:#92400e;padding:8px 16px;font-size:13px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">' +
        '<span>🆕 Nova versão disponível: <strong>v' + disponivel.versao + '</strong></span>' +
        (disponivel.urlRelease ? '<a href="' + disponivel.urlRelease + '" target="_blank" rel="noopener" style="color:#92400e;text-decoration:underline">Ver notas da versão</a>' : '') +
        '<button id="btn-atualizar-agora" style="margin-left:auto;padding:4px 14px;font-size:12px;border:1px solid #92400e;border-radius:var(--radius-sm);background:white;color:#92400e;cursor:pointer;font-family:var(--font-sans)">Atualizar agora</button>' +
        '</div>';
      return;
    }

    wrap.innerHTML = '';
  }

  async function _iniciarAtualizacaoManual(btn) {
    if (!confirm('O cliente vai baixar a nova versão, substituir o executável e reiniciar sozinho — isso pode levar até ~10 segundos. Se algo der errado, ele reverte automaticamente para a versão atual. Continuar?')) return;
    btn.disabled = true;
    btn.textContent = 'Atualizando…';
    try {
      var r = await fetch('/atualizacao/aplicar', { method: 'POST' });
      var d = await r.json();
      if (!d.ok) {
        _notificarErro(btn, 'Erro ao atualizar: ' + (d.message || 'erro desconhecido'));
        btn.disabled = false;
        btn.textContent = 'Atualizar agora';
      }
      // Sucesso: o evento SSE 'atualizacao-status' já atualiza o banner sozinho.
    } catch (ex) {
      // A conexão pode cair se o processo antigo já tiver saído — não é necessariamente erro.
    }
  }

  document.addEventListener('click', function (e) {
    if (e.target && e.target.id === 'btn-atualizar-agora') _iniciarAtualizacaoManual(e.target);
  });

  renderBannerAtualizacao(window.__atualizacaoDisponivelInicial, window.__atualizacaoStatusInicial);

  // ── SSE: badges e notificações em tempo real ─────────────────────────────
  (function () {
    fetch('/api/erros/count')
      .then(function(r) { return r.json(); })
      .then(function(d) { atualizarBadgeErros(d.total); })
      .catch(function() {});

    fetch('/api/conflitos/count')
      .then(function(r) { return r.json(); })
      .then(function(d) { atualizarBadgeConflitos(d.total); })
      .catch(function() {});

    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }

    var es = new EventSource('/eventos');

    es.addEventListener('novo-erro', function(e) {
      try {
        var erro = JSON.parse(e.data);
        var badge = document.getElementById('erros-badge');
        var atual = badge ? (parseInt(badge.textContent, 10) || 0) : 0;
        atualizarBadgeErros(atual + 1);
        if ('Notification' in window && Notification.permission === 'granted') {
          new Notification('Erro de Sincronização', {
            body: (erro.tabela ? '[' + erro.tabela + '] ' : '') + erro.mensagem,
            tag: 'sync-erro-' + (erro.tabela || 'geral'),
          });
        }
      } catch (_) {}
    });

    es.addEventListener('novo-conflito', function(e) {
      try {
        var c = JSON.parse(e.data);
        var badge = document.getElementById('conflitos-badge');
        var atual = badge ? (parseInt(badge.textContent, 10) || 0) : 0;
        atualizarBadgeConflitos(atual + 1);
        if ('Notification' in window && Notification.permission === 'granted') {
          new Notification('Conflito de Sincronização', {
            body: (c.tabela ? '[' + c.tabela + '] ' : '') + 'PK: ' + c.pkValor,
            tag: 'sync-conflito-' + (c.tabela || 'geral'),
          });
        }
      } catch (_) {}
    });

    es.addEventListener('atualizacao-status', function(e) {
      try {
        var status = JSON.parse(e.data);
        renderBannerAtualizacao(window.__atualizacaoDisponivelInicial, status);
      } catch (_) {}
    });

    es.onerror = function() {};
  })();

  function atualizarBadgeErros(total) {
    var badge = document.getElementById('erros-badge');
    if (!badge) return;
    if (total > 0) { badge.textContent = total; badge.style.display = 'inline'; }
    else { badge.style.display = 'none'; }
  }

  function atualizarBadgeConflitos(total) {
    var badge = document.getElementById('conflitos-badge');
    if (!badge) return;
    if (total > 0) { badge.textContent = total; badge.style.display = 'inline'; }
    else { badge.style.display = 'none'; }
  }

  // ── Toggle de conflitos — event delegation (P0-D / CSP) ──────────────────
  // Substitui onclick inline por listener delegado, compatível com
  // Content-Security-Policy script-src 'self'. Usa .hidden (semântico) em
  // vez de style.display, para que leitores de tela tratem o painel como
  // ausente da árvore de acessibilidade quando colapsado.
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-toggle-target]');
    if (!btn) return;
    var target = document.getElementById(btn.dataset.toggleTarget);
    if (!target) return;
    var aberto = btn.getAttribute('aria-expanded') === 'true';
    target.hidden = aberto;
    btn.setAttribute('aria-expanded', String(!aberto));
    var icon = btn.querySelector('.toggle-icon');
    if (icon) icon.textContent = aberto ? '▼ Ver detalhes' : '▲ Ocultar';
  });
</script>
</body>
</html>
