<nav aria-label="Navegação principal">
  <% if (abasPermitidas.has('conflitos')) { %>
  <a href="/" id="nav-conflitos" <%- currentPage === 'conflitos' ? 'aria-current="page"' : '' %>>
    Conflitos
    <span id="conflitos-badge"
          class="badge"
          role="status"
          aria-live="polite"
          aria-label="conflitos pendentes"
          style="display:none;font-size:11px;padding:1px 6px"></span>
  </a>
  <% } %>
  <% if (abasPermitidas.has('status')) { %>
  <a href="/status" <%- currentPage === 'status' ? 'aria-current="page"' : '' %>>Status</a>
  <% } %>
  <% if (abasPermitidas.has('auditoria')) { %>
  <a href="/auditoria" <%- currentPage === 'auditoria' ? 'aria-current="page"' : '' %>>Auditoria</a>
  <% } %>
  <% if (abasPermitidas.has('configuracoes')) { %>
  <a href="/configuracoes" <%- currentPage === 'configuracoes' ? 'aria-current="page"' : '' %>>Configurações</a>
  <% } %>
  <% if (abasPermitidas.has('erros')) { %>
  <a href="/erros" id="nav-erros" <%- currentPage === 'erros' ? 'aria-current="page"' : '' %>>
    Erros
    <span id="erros-badge"
          class="badge"
          role="status"
          aria-live="polite"
          aria-label="erros de sincronização"
          style="display:none;font-size:11px;padding:1px 6px"></span>
  </a>
  <% } %>
  <% if (abasPermitidas.has('parametros')) { %>
  <a href="/parametros" <%- currentPage === 'parametros' ? 'aria-current="page"' : '' %>>Parâmetros</a>
  <% } %>
  <div style="margin-left:auto;display:flex;align-items:center;gap:10px">
    <span style="font-size:12px;color:var(--color-text-muted)"><%= usuarioLogado %></span>
    <form method="post" action="/logout" style="margin:0">
      <button type="submit"
        style="padding:3px 12px;font-size:12px;border:1px solid #d1d5db;border-radius:var(--radius-sm);background:white;color:var(--color-text-secondary);cursor:pointer;font-family:var(--font-sans)">
        Sair
      </button>
    </form>
  </div>
</nav>

<% if (typeof atualizacaoDisponivel !== 'undefined' && atualizacaoDisponivel) { %>
<div id="banner-atualizacao" style="background:#fef3c7;border-bottom:1px solid #fcd34d;color:#92400e;padding:8px 16px;font-size:13px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
  <span>🆕 Nova versão disponível: <strong>v<%= atualizacaoDisponivel.versao %></strong></span>
  <% if (atualizacaoDisponivel.urlRelease) { %>
    <a href="<%= atualizacaoDisponivel.urlRelease %>" target="_blank" rel="noopener" style="color:#92400e;text-decoration:underline">Ver notas da versão</a>
  <% } %>
  <button id="btn-atualizar-agora" style="margin-left:auto;padding:4px 14px;font-size:12px;border:1px solid #92400e;border-radius:var(--radius-sm);background:white;color:#92400e;cursor:pointer;font-family:var(--font-sans)">Atualizar agora</button>
</div>
<script>
(function () {
  var btn = document.getElementById('btn-atualizar-agora');
  if (!btn) return;
  btn.addEventListener('click', async function () {
    if (!confirm('O cliente vai baixar a nova versão, se reiniciar e ficar indisponível por alguns segundos. Continuar?')) return;
    btn.disabled = true;
    btn.textContent = 'Atualizando…';
    try {
      var r = await fetch('/atualizacao/aplicar', { method: 'POST' });
      var d = await r.json();
      if (!d.ok) {
        alert('Erro ao atualizar: ' + (d.message || 'erro desconhecido'));
        btn.disabled = false;
        btn.textContent = 'Atualizar agora';
        return;
      }
      btn.textContent = 'Reiniciando…';
      document.getElementById('banner-atualizacao').style.background = '#dcfce7';
    } catch (ex) {
      // A conexão cai assim que o processo reinicia — é o comportamento esperado.
      btn.textContent = 'Reiniciando…';
    }
  });
})();
</script>
<% } %>
