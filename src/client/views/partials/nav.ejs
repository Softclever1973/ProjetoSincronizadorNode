<nav aria-label="Navegação principal">
  <% if (abasPermitidas.has('conflitos')) { %>
  <a href="/" id="nav-conflitos" <%- currentPage === 'conflitos' ? 'aria-current="page"' : '' %>>
    Conflitos
    <span id="conflitos-badge"
          class="badge"
          role="status"
          aria-live="polite"
          aria-label="conflitos pendentes"
          style="display:none;font-size:11px;padding:1px 6px"></span>
  </a>
  <% } %>
  <% if (abasPermitidas.has('status')) { %>
  <a href="/status" <%- currentPage === 'status' ? 'aria-current="page"' : '' %>>Status</a>
  <% } %>
  <% if (abasPermitidas.has('auditoria')) { %>
  <a href="/auditoria" <%- currentPage === 'auditoria' ? 'aria-current="page"' : '' %>>Auditoria</a>
  <% } %>
  <% if (abasPermitidas.has('configuracoes')) { %>
  <a href="/configuracoes" <%- currentPage === 'configuracoes' ? 'aria-current="page"' : '' %>>Configurações</a>
  <% } %>
  <% if (abasPermitidas.has('erros')) { %>
  <a href="/erros" id="nav-erros" <%- currentPage === 'erros' ? 'aria-current="page"' : '' %>>
    Erros
    <span id="erros-badge"
          class="badge"
          role="status"
          aria-live="polite"
          aria-label="erros de sincronização"
          style="display:none;font-size:11px;padding:1px 6px"></span>
  </a>
  <% } %>
  <% if (abasPermitidas.has('parametros')) { %>
  <a href="/parametros" <%- currentPage === 'parametros' ? 'aria-current="page"' : '' %>>Parâmetros</a>
  <% } %>
  <div style="margin-left:auto;display:flex;align-items:center;gap:10px">
    <% const _pausado = typeof syncPausa !== 'undefined' && syncPausa && syncPausa.pausado; %>
    <button type="button" id="btn-sync-pausa" onclick="alternarPausaSync()" data-pausado="<%= _pausado ? '1' : '0' %>"
      title="<%= _pausado ? 'Retoma a sincronização agora' : 'Para a sincronização no próximo registro (sem fechar o programa)' %>"
      style="padding:3px 12px;font-size:12px;border:1px solid <%= _pausado ? '#27ae60' : '#e67e22' %>;border-radius:var(--radius-sm);background:white;color:<%= _pausado ? '#27ae60' : '#e67e22' %>;cursor:pointer;font-family:var(--font-sans);font-weight:bold">
      <%= _pausado ? '▶ Retomar sincronização' : '⏸ Pausar sincronização' %>
    </button>
    <span style="font-size:12px;color:var(--color-text-muted)"><%= usuarioLogado %></span>
    <form method="post" action="/logout" style="margin:0">
      <button type="submit"
        style="padding:3px 12px;font-size:12px;border:1px solid #d1d5db;border-radius:var(--radius-sm);background:white;color:var(--color-text-secondary);cursor:pointer;font-family:var(--font-sans)">
        Sair
      </button>
    </form>
  </div>
</nav>

<% if (typeof syncPausa !== 'undefined' && syncPausa && syncPausa.pausado) { %>
<div id="banner-sync-pausada" role="status" style="margin:0 0 16px;padding:10px 14px;border-radius:6px;background:#fff3cd;color:#856404;font-size:13px">
  ⏸ Sincronização pausada<%= syncPausa.por ? ' por ' + syncPausa.por : '' %><%= syncPausa.desde ? ' em ' + new Date(syncPausa.desde).toLocaleString('pt-BR') : '' %>.
  Nada é enviado nem recebido até retomar. As alterações feitas no Sirius continuam sendo registradas e sobem quando retomar.
</div>
<% } else if (typeof syncPausa !== 'undefined' && syncPausa && syncPausa.cargaPausada) { %>
<div id="banner-carga-pausada" role="status" style="margin:0 0 16px;padding:10px 14px;border-radius:6px;background:#fff3cd;color:#856404;font-size:13px;display:flex;align-items:center;gap:12px">
  <span style="flex:1">⏸ Carga inicial pausada<%= syncPausa.cargaPor ? ' por ' + syncPausa.cargaPor : '' %><%= syncPausa.cargaDesde ? ' em ' + new Date(syncPausa.cargaDesde).toLocaleString('pt-BR') : '' %>.
  Só a carga espera; as alterações do dia a dia continuam sendo enviadas e o recebimento do servidor também.</span>
  <button type="button" onclick="retomarCargaSync(this)" style="padding:3px 12px;font-size:12px;border:1px solid #27ae60;border-radius:4px;background:white;color:#27ae60;cursor:pointer;font-weight:bold">▶ Retomar carga</button>
</div>
<% } %>
<script>
  async function alternarPausaSync() {
    var btn = document.getElementById('btn-sync-pausa');
    var pausado = btn.dataset.pausado === '1';
    if (!pausado && !confirm('Pausar a sincronização? O ciclo atual para no próximo registro.')) return;
    btn.disabled = true;
    try {
      var r = await fetch(pausado ? '/api/sync/retomar' : '/api/sync/pausar', { method: 'POST' });
      if (!r.ok) throw new Error('HTTP ' + r.status);
      location.reload();
    } catch (e) {
      alert('Não foi possível ' + (pausado ? 'retomar' : 'pausar') + ': ' + e.message);
      btn.disabled = false;
    }
  }
  async function retomarCargaSync(btn) {
    btn.disabled = true;
    try {
      var r = await fetch('/api/sync/retomar-carga', { method: 'POST' });
      if (!r.ok) throw new Error('HTTP ' + r.status);
      location.reload();
    } catch (e) {
      alert('Não foi possível retomar a carga: ' + e.message);
      btn.disabled = false;
    }
  }
</script>

<!-- Preenchido no load e mantido em tempo real via SSE 'atualizacao-status' — ver
     renderBannerAtualizacao() em scripts.ejs. Server-side só fornece o estado inicial. -->
<div id="banner-atualizacao-wrap"></div>
<script>
  window.__atualizacaoDisponivelInicial = <%- JSON.stringify(typeof atualizacaoDisponivel !== 'undefined' ? atualizacaoDisponivel : null) %>;
  window.__atualizacaoStatusInicial = <%- JSON.stringify(typeof atualizacaoStatus !== 'undefined' ? atualizacaoStatus : null) %>;
</script>

<!-- Preenchido no load e mantido em tempo real via SSE 'novo-reset-pendente' — ver
     renderBannerReset() em scripts.ejs. Server-side só fornece o estado inicial. -->
<div id="banner-reset-wrap"></div>
<script>
  window.__resetPendenteInicial = <%- JSON.stringify(typeof resetPendente !== 'undefined' ? resetPendente : null) %>;
</script>
