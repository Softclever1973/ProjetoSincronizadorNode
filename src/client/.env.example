# Este arquivo só é usado em desenvolvimento (npm run client). No .exe empacotado no
# Windows, o wizard de primeira execução grava as credenciais criptografadas via DPAPI
# em config.enc (amarrado a este Windows/usuário) em vez de um .env em texto puro — veja
# "Armazenamento de credenciais" no CLAUDE.md.

# Token de autenticação — deve ser idêntico ao registrado no servidor (sync_tenants)
SYNC_TOKEN=seu-token-aqui

# Conexão Firebird
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\FDBS\FILIAL.FDB
FIREBIRD_VERSION=3
FIREBIRD_PASSWORD=senha-customizada

# Intervalo do ciclo de sync em ms (padrão: 30000)
INTERVALO_MS=30000

# Atualização automática do client.exe (padrão: ligada). Detecção e aplicação exigem o
# .exe empacotado (não fazem nada rodando via "node index.js"). Defina 'false' para manter
# só o fluxo manual de hoje (banner + botão "Atualizar agora").
# AUTO_ATUALIZAR=false
